@model Shared.CustomerRegistration.Contracts.Cep.CepResponse?
@{
    ViewData["Title"] = "Consultar CEP";
}

<div class="mb-6 flex items-center justify-between">
    <h1 class="title">Consultar CEP</h1>
    <a asp-action="Index" class="btn-secondary">Voltar</a>
</div>

<form asp-controller="Home" asp-action="Cep" method="post" class="grid gap-4 sm:grid-cols-[220px_auto] items-end" novalidate>
    @Html.AntiForgeryToken()

    <div class="sm:col-span-1">
        <label for="cep" class="block text-sm font-medium text-gray-700">CEP</label>
        <input id="cep" name="cep" maxlength="9"
               class="mt-1 block w-48 sm:w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
               placeholder="00000-000" />
        <p class="mt-1 text-xs text-gray-500">Digite 8 dígitos. Ex.: 13083852</p>
    </div>

    <div class="flex gap-2 sm:col-span-1">
        <button type="submit" class="btn-primary">Buscar</button>
        <a asp-action="Index" class="btn-secondary">Cancelar</a>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mt-4 rounded-lg bg-red-50 p-3 text-red-700 ring-1 ring-red-200">
        @foreach (var kv in ViewData.ModelState)
        {
            foreach (var err in kv.Value.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        }
    </div>
}

@if (Model is not null)
{
    <div class="mt-6">
        <h2 class="text-lg font-medium mb-3">Resultado</h2>
        <div class="overflow-hidden rounded-xl ring-1 ring-gray-200">
            <dl class="divide-y divide-gray-200">
                @foreach (var p in Model.GetType().GetProperties())
                {
                    var val = p.GetValue(Model) ?? "";
                    <div class="grid grid-cols-3 gap-4 p-3 sm:grid-cols-4">
                        <dt class="col-span-1 text-sm font-medium text-gray-600">@p.Name</dt>
                        <dd class="col-span-2 sm:col-span-3 text-sm break-words">@val</dd>
                    </div>
                }
            </dl>
        </div>
    </div>
}

@if (ViewBag.RawJson is string raw && !string.IsNullOrWhiteSpace(raw))
{
    <details class="mt-4 overflow-hidden rounded-xl ring-1 ring-gray-200">
        <summary class="cursor-pointer select-none bg-gray-50 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100">Ver JSON</summary>
        <pre class="max-h-72 overflow-auto p-4 text-xs">@raw</pre>
    </details>
}

@section Scripts {
    <script>
        document.getElementById('cep')?.addEventListener('input', e => {
            const i = e.target; const d = i.value.replace(/\D/g, '').slice(0,8);
            i.value = d.length > 5 ? d.slice(0,5) + '-' + d.slice(5) : d;
        });
    </script>
}