@model Shared.CustomerRegistration.Contracts.Cep.CepResponse?
@{
    ViewData["Title"] = "Consultar CEP";
}

<h1 class="mb-3">Consultar CEP</h1>

<form asp-controller="Home" asp-action="Cep" method="post" class="row g-3">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-auto">
        <label for="cep" class="form-label">CEP</label>
        <input id="cep" name="cep" maxlength="9" class="form-control" placeholder="00000-000" />
    </div>

    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</form>

@if (Model is not null)
{
    <hr />
    <h5>Resultado</h5>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <tbody>
                @foreach (var p in Model.GetType().GetProperties())
                {
                    <tr>
                        <th style="width:200px">@p.Name</th>
                        <td>@(p.GetValue(Model) ?? "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (ViewBag.RawJson is string raw && !string.IsNullOrWhiteSpace(raw))
{
    <details class="mt-3">
        <summary>Ver JSON</summary>
        <pre class="mt-2">@raw</pre>
    </details>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('cep')?.addEventListener('input', e => {
            const i = e.target; const d = i.value.replace(/\D/g, '').slice(0,8);
            i.value = d.length > 5 ? d.slice(0,5) + '-' + d.slice(5) : d;
        });
    </script>
}
