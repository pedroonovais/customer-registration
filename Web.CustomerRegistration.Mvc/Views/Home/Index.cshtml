@model List<Shared.CustomerRegistration.Contracts.Customers.CustomerDto>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">Clientes</h1>
    <div class="d-flex gap-2">
        <a asp-action="Cep" class="btn btn-outline-secondary">Consultar CEP</a>
        <a asp-action="Create" class="btn btn-primary">Novo Cliente</a>
    </div>
</div>

@if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
{
    <div class="alert alert-success" role="alert">@flash</div>
}
@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger" role="alert">@err</div>
}

@if (Model is { Count: > 0 })
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Profissão</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.Name</td>
                        <td>@c.Email</td>
                        <td>@c.Occupation</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-muted">Nenhum cliente cadastrado ainda.</div>
}
