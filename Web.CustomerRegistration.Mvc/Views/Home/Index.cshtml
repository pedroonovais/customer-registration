@using Shared.CustomerRegistration.Contracts.Customers
@model IEnumerable<CustomerDto>
@{
    Layout = null;
}
<h2>Customers</h2>
<ul>
    @foreach (var p in Model)
    {
        <li>@p.Name - @p.Email</li>
    }
</ul>

<form method="post" asp-action="Cep">
    <input name="cep" placeholder="Digite o CEP" />
    <button type="submit">Consultar CEP</button>
</form>