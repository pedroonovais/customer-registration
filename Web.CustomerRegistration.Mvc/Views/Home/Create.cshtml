@model Web.CustomerRegistration.Mvc.Models.CreateCustomerViewModel
@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="mb-6 flex items-center justify-between">
    <h1 class="title">Novo Cliente</h1>
    <a asp-action="Index" class="btn-secondary">Voltar</a>
</div>

@if (TempData["Error"] is string apiErr && !string.IsNullOrWhiteSpace(apiErr))
{
    <div class="mb-4 rounded-lg bg-red-50 p-4 text-red-700 ring-1 ring-red-200">@apiErr</div>
}

<form asp-controller="Home" asp-action="Create" method="post" class="grid gap-4" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="rounded-lg bg-red-50 p-3 text-red-700 ring-1 ring-red-200"></div>

    <div>
        <label asp-for="Name" class="block text-sm font-medium text-gray-700"></label>
        <input asp-for="Name" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
        <span asp-validation-for="Name" class="text-sm text-red-600"></span>
    </div>

    <div>
        <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
        <input asp-for="Email" type="email" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
        <span asp-validation-for="Email" class="text-sm text-red-600"></span>
    </div>

    <div>
        <label asp-for="Occupation" class="block text-sm font-medium text-gray-700"></label>
        <input asp-for="Occupation" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
        <span asp-validation-for="Occupation" class="text-sm text-red-600"></span>
    </div>

    <div class="mt-2 flex gap-2">
        <button type="submit" class="btn-primary">Cadastrar</button>
        <a asp-action="Index" class="btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
}
